/* Content Gallery Styles */

.content-gallery-wrapper {
  display: flex;
  height: 80vh;
  gap: 10px;
  overflow: hidden;
  border: 1px solid var(--border-color);
  padding: 10px;
}

.left-panel {
  flex: 1;
  overflow-y: auto;
  padding: 10px;
  border-right: 1px solid var(--border-color);
}

.content-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
  gap: 20px;
}

.content-panel {
  cursor: pointer;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 10px;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.2s;
}

.content-panel:hover { transform: scale(1.02); }

.content-panel-image-container {
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: 4px;
}

.content-panel-image-container img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.content-panel-title {
  margin-top: 10px;
  font-weight: bold;
  text-align: center;
  width: 100%;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: clamp(0.7rem, 1vw + 0.5rem, 1rem);
}

.content-splitter {
  width: 10px;
  cursor: col-resize;
  background: var(--border-color);
  border-radius: 4px;
}

.right-panel {
  flex: 1;
  padding: 20px;
  overflow-y: auto;
  min-width: 300px;
}

#preview-image-container img {
  width: 100%;
  max-height: 400px;
  object-fit: contain;
}

